# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string
S3_BUCKET=expense-receipts
# For MinIO/LocalStack only; leave empty for real AWS (IAM role):
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
# Tests
TEST_DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense_test
TEST_REDIS_URL=redis://localhost:6379/15
